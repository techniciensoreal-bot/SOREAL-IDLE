# Profileur d'échantillonnage de la page (API « JS Self-Profiling », Chromium), utilisé SEULEMENT par la mesure de référence de l'administrateur (modules/mesure-reference-v1.js, option « avec profil par fonction ») pour attribuer le temps du fil principal sur un téléphone.
# Sans cet en-tête le navigateur refuse de construire un Profiler ; avec lui, une page ne peut que se profiler elle-même (aucun accès à d'autres origines).
/
  Document-Policy: js-profiling
/index.html
  Document-Policy: js-profiling

# Fichiers du frontend versionnés par ?v=N (voir cloudflare/tools/maj-pins.mjs et le test idle-pins-assets-v1) : jamais redemandés tant que leur adresse ne change pas.
/modules/*
  Cache-Control: public, max-age=31536000, immutable
/soreal-idle-*.js
  Cache-Control: public, max-age=31536000, immutable
/soreal-idle-*.css
  Cache-Control: public, max-age=31536000, immutable
/standalone-bridge.js
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/wandoos/*
  Cache-Control: public, max-age=31536000, immutable
/machine-v2/*
  Cache-Control: public, max-age=31536000, immutable
/machine-v3/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker (hors ligne) : toujours revalide, jamais fige par le cache HTTP (sinon une correction ne partirait pas).
/sw-idle-v1.js
  Cache-Control: no-cache
/magic/*
  Cache-Control: public, max-age=604800

# Images et ressources SANS empreinte dans le nom (audit de coherence 2026-11-09, Front 7) : jamais `immutable`, une image remplacee sous le meme nom doit finir par arriver.
# Verifie dans l'historique git : aucun fichier de ces dossiers n'a ete remplace sous le meme nom (seul /garderie : 11 fichiers yeux/ retouches le 2026-11-02 -> 1 jour seulement).
# 7 jours + 1 jour de stale-while-revalidate : le navigateur sert la copie tout de suite et la rafraichit en arriere-plan. Le service worker (sw-idle-v1.js) garde sa propre copie
# « copie d'abord, rafraichie en arriere-plan » pour ces adresses : il passe par ce cache HTTP, donc un remplacement arrive au plus tard apres ce delai.
/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/shop/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/dos-cartes/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/perks/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/cthulhu/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/intro/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/chargement/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/trou/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
# Icones d'application (manifeste PWA, index.html) : sensibles, 7 jours sans stale-while-revalidate.
/icons/*
  Cache-Control: public, max-age=604800
# Garderie : des fichiers ont deja ete retouches sous le meme nom -> 1 jour.
/garderie/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400
